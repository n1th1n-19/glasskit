#!/usr/bin/env python3
"""COSMIC variant: symbolic-only. Build the glasskit-filled icon theme: freedesktop UI icon names mapped to Material Symbols Rounded (filled).

Output: ~/.local/share/icons/glasskit-filled, inheriting Cosmic for everything not mapped.
Icons carry KDE's current-color-scheme stylesheet so Plasma/KDE recolor them with the theme.
Re-run any time; downloads are cached in ~/.cache/glasskit-filled-icons.
Source icons: Google Material Symbols, Apache License 2.0.
"""
import re
import shutil
import sys
import urllib.request
from pathlib import Path

