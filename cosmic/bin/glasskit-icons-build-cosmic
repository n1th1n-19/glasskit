CACHE = Path.home() / ".cache/glasskit-filled-icons"
URL = "https://raw.githubusercontent.com/google/material-design-icons/master/symbols/web/{0}/materialsymbolsrounded/{0}_fill1_24px.svg"

# KDE icon name -> Material Symbols name. "actions"/"status" are small by nature; "places" only get -symbolic names
# so large folder/drive icons in file managers stay Breeze.
