# Wi-Fi strength families used by Plasma's network applet
for pct, m in [("100", "wifi"), ("80", "network_wifi_3_bar"), ("75", "network_wifi_3_bar"), ("60", "network_wifi_2_bar"),
               ("50", "network_wifi_2_bar"), ("40", "network_wifi_1_bar"), ("25", "network_wifi_1_bar"),
               ("20", "network_wifi_1_bar"), ("0", "signal_wifi_0_bar"), ("00", "signal_wifi_0_bar")]:
    STATUS[f"network-wireless-{pct}"] = m
    STATUS[f"network-wireless-{pct}-locked"] = m
    STATUS[f"network-wireless-connected-{pct}"] = m
for q, m in [("excellent", "wifi"), ("good", "network_wifi_3_bar"), ("ok", "network_wifi_2_bar"),
             ("weak", "network_wifi_1_bar"), ("low", "network_wifi_1_bar"), ("none", "signal_wifi_0_bar")]:
    STATUS[f"network-wireless-signal-{q}"] = m
    STATUS[f"network-wireless-signal-{q}-secure"] = m
# battery levels, plain and charging
BARS = {100: "battery_full", 90: "battery_6_bar", 80: "battery_6_bar", 70: "battery_5_bar", 60: "battery_4_bar",
        50: "battery_4_bar", 40: "battery_3_bar", 30: "battery_2_bar", 20: "battery_1_bar", 10: "battery_0_bar", 0: "battery_alert"}
CHG = {100: "battery_charging_full", 90: "battery_charging_90", 80: "battery_charging_80", 70: "battery_charging_60",
       60: "battery_charging_60", 50: "battery_charging_50", 40: "battery_charging_30", 30: "battery_charging_30",
       20: "battery_charging_20", 10: "battery_charging_20", 0: "battery_charging_20"}
for lvl in BARS:
    STATUS[f"battery-{lvl:03d}"] = BARS[lvl]
    STATUS[f"battery-{lvl:03d}-charging"] = CHG[lvl]

STYLE = '<style type="text/css" id="current-color-scheme">.ColorScheme-Text{color:#fcfcfc;}</style>'


def material(name: str) -> str:
    CACHE.mkdir(parents=True, exist_ok=True)
    f = CACHE / f"{name}.svg"
    if not f.exists():
        req = urllib.request.Request(URL.format(name), headers={"User-Agent": "glasskit-icons/1.0"})
        with urllib.request.urlopen(req, timeout=30) as r:
            f.write_bytes(r.read())
    return f.read_text()


def kde_svg(src: str) -> str:
    # one recolourable path set: class + currentColor so KDE swaps the stylesheet colour
    body = re.sub(r"<path ", '<path class="ColorScheme-Text" fill="currentColor" ', src)
    return body


def main() -> int:
    if OUT.exists():
        shutil.rmtree(OUT)
    sizes = ["16", "22", "24"]
    failed = []
    count = 0
    for ctx, table, plain in (("actions", ACTIONS, False), ("status", STATUS, False), ("places", PLACES, False)):
        for kde, mat in table.items():
            try:
                svg = kde_svg(material(mat))
            except Exception as e:  # missing upstream name: leave this icon to Breeze
                failed.append(f"{kde}->{mat}: {e}")
                continue
            if plain:
                for s in sizes:
                    d = OUT / ctx / s
                    d.mkdir(parents=True, exist_ok=True)
                    (d / f"{kde}.svg").write_text(svg)
            d = OUT / "symbolic" / ctx
            d.mkdir(parents=True, exist_ok=True)
            (d / f"{kde}-symbolic.svg").write_text(svg)
            count += 1
    dirs = [f"symbolic/{c}" for c in ("actions", "status", "places")]
    idx = ["[Icon Theme]", "Name=Glasskit Filled", "Comment=Rounded filled UI icons (Material Symbols) over Cosmic",
           "Inherits=Cosmic,Adwaita,hicolor", "Directories=" + ",".join(dirs), ""]
    for dd in dirs:
        ctx = dd.split("/")[-1] if dd.startswith("symbolic") else dd.split("/")[0]
        context = {"actions": "Actions", "status": "Status", "places": "Places"}[ctx]
        if dd.startswith("symbolic"):
            idx += [f"[{dd}]", "Size=16", "MinSize=8", "MaxSize=512", f"Context={context}", "Type=Scalable", ""]
        else:
            idx += [f"[{dd}]", f"Size={dd.split('/')[1]}", f"Context={context}", "Type=Fixed", ""]
    (OUT / "index.theme").write_text("\n".join(idx))
    # self-check: theme exists, most names built, every icon carries the KDE colour hook
    sample = next((OUT / "symbolic" / "status").glob("*.svg"))
    assert "<script" not in sample.read_text() and 'fill="currentColor"' in sample.read_text()
    assert count > 150, f"only {count} icons built"
    print(f"Glasskit-Filled: {count} icon names built, {len(failed)} skipped")
    for f in failed:
        print("  skipped", f)
    return 0


if __name__ == "__main__":
    sys.exit(main())
