[Desktop Entry]
Name=Glasskit Space (8 px)
Comment=Invisible 8 px gap between panel applets
Type=Application
Exec=env ICED_BACKEND=tiny-skia glasskit-applets space-s
Terminal=false
Categories=COSMIC;
Icon=view-more-horizontal-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-OverflowPriority=5
